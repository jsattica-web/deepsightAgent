server {
    # Cloud Run이 주입하는 PORT를 사용한다. 컨테이너 시작 시 envsubst가 치환한다.
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Cloud Run 프론트엔드가 이미 압축을 처리하지만, 직접 접근 대비로 남겨둔다.
    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json image/svg+xml;

    # 컨테이너 기동 확인용
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # ---- A안 핵심: /api 요청을 agent-python 서비스로 중계한다 ----
    # 브라우저 입장에서는 오리진이 하나이므로 CORS가 발생하지 않는다.
    # (agent-python에는 CORS 미들웨어가 없으므로 이 프록시가 반드시 필요하다.)
    location /api/ {
        # agent-python은 '/api' 프리픽스 없이 서빙한다.
        #   /agent/chat, /agent/briefing, /tools/..., /health
        # 따라서 프리픽스를 떼고 넘긴다. (예: /api/agent/chat -> /agent/chat)
        # break를 쓰면 아래 proxy_pass가 재작성된 경로를 그대로 사용한다.
        rewrite ^/api/(.*)$ /$1 break;

        # 주의: proxy_pass에 경로를 붙이면 위 rewrite 결과가 무시된다.
        # 호스트까지만 적어야 한다. BACKEND_URL 값은 agent-python의 Cloud Run URL이다.
        proxy_pass ${BACKEND_URL};

        # Cloud Run은 Host 헤더로 서비스를 라우팅하므로 대상 호스트로 맞춰야 한다.
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 공유 시크릿 헤더. 현재 agent-python에는 이 값을 검증하는 코드가 없어
        # 실질적인 보호 효과가 없다. 인증 방식이 정해지면 함께 정리해야 한다.
        proxy_set_header X-Internal-Token  "${INTERNAL_TOKEN}";

        # HTTPS 대상일 때 SNI를 보내야 Cloud Run이 라우팅할 수 있다.
        proxy_ssl_server_name on;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # LLM 응답은 수 초~수십 초가 걸릴 수 있다.
        proxy_connect_timeout 60s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;

        # SSE/스트리밍 응답을 쓰게 될 경우를 대비해 버퍼링을 끈다.
        proxy_buffering off;
    }

    # 해시가 붙은 빌드 산출물은 장기 캐시가 안전하다.
    location /assets/ {
        # expires 지시어와 add_header를 함께 쓰면 Cache-Control 헤더가
        # 두 번 내려간다. add_header 하나에 max-age까지 담는다.
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html은 항상 최신을 받아야 배포가 즉시 반영된다.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # SPA 라우팅 대응. 라우터 도입 시 새로고침 404를 방지한다.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
